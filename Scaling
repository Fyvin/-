# 缩小
#crop (已知目标hw)
def crop_zc(src, new_h, new_w):
    """
    :param src: src gray
    :param new_h: dst h
    :param new_w: dst w
    :return: dst gray
    """
    s_h, s_w = src.shape[:2]
    if new_h > s_h or new_w > s_w:
        return src
    # dh, dw
    dh, dw = abs(new_h - s_h), abs(new_w - s_w)
    # 上下左右平均crop
    up = dh // 2
    left = dw // 2
    dst = img[up:up+new_h,left:left+new_w]
    return dst

# --------------- 下采样 ---------------
#跨步卷积
def conv_zc(src, kernel, stride=2, bias):
    """
    :param src: src gray
    :param kernel: 卷积核(k*k)
    :param stride: 步长
    :param bias: 偏置项
    :return: dst gray
    """
    h, w = src.shape[:2]
    #padding
    new_h, new_w = h+stride, w+stride
    pad_img = padding_zc(src, new_h, new_w)
    pad_h, pad_w = pad_img.shape[:2]
    #windows
    k_size = kernel[0]
    h_out = (pad_h - k_size) // stride + 1
    w_out = (pad_w - k_size) // stride + 1
    windows = pad_img.reshape(k_size, h_out, k_size, w_out)
    #conv = windows * kernel + bias
    dst = np.sum(windows * kernel,axis=(1,3))+bias
    return dst


#池化(平均/最大) 带padding
def pooling_zc(src, pool_size=2, stride=2, ptype = 'max'):
    """
    手动实现最大池化操作
    :param src: src gray
    :param pool_size: 池化窗口大小
    :param stride: 滑动步长
    :return: 池化后的特征图
    """
    # 计算输出特征图尺寸
    h, w = src.shape[:2]
    # padding
    new_h, new_w = h+stride, w+stride
    pad_img = padding_zc(src, new_h, new_w)
    h_pad, w_pad = pad_img.shape[:2]
    h_out = (h_pad - pool_size) // stride + 1
    w_out = (w_pad - pool_size) // stride + 1
    #池化
    windows = src[:h_out * stride, :w_out * stride].reshape(h_out, pool_size, w_out, pool_size)
    if ptype=='max':
        # 最大池化 - 每个窗口维度宽高取最大
        dst = windows.max(axis=(1, 3))  # 在窗口高pool_size、宽pool_size窗口上做 max
        # 平均池化 - 每个窗口维度宽高取平均
    if ptype == 'mean':
        dst = windows.mean(axis=(1, 3))  # 在窗口高pool_size、宽pool_size窗口上做 max

    return dst


