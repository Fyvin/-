    dilated[::stride, ::stride] = src  # 切片插入空洞

    # 2. 边界填充 - stride倍
    pad = k - 1
    dilated_pad = np.pad(dilated, pad, mode='constant')
    windows = dilated_pad.reshape(H_out,k,W_out,k)
    dst = np.sum(windows*kernel, axis=(1,3))+ bias
