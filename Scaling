# 放大
#padding (已知目标hw)
def padding_zc(src, new_h, new_w):
    """
    :param src: src gray
    :param new_h: dst h
    :param new_w: dst w
    :return: dst gray
    """
    s_h, s_w = src.shape[:2]
    if new_h < s_h or new_w < s_w:
        return src
    # dh, dw
    dh, dw = abs(new_h - s_h), abs(new_w - s_w)
    # 上下左右平均padding
    up = dh//2
    down = dh - dh//2
    left = dw//2
    right = dw - dw//2
    dst = np.pad(src, ((up,down),(left,right)), "constant")
    return dst

