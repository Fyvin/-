# 放大
#padding (已知目标hw)
def padding_zc(src, new_h, new_w):
    """
    :param src: src gray
    :param new_h: dst h
    :param new_w: dst w
    :return: dst gray
    """
    s_h, s_w = src.shape[:2]
    if new_h < s_h or new_w < s_w:
        return src
    # dh, dw
    dh, dw = abs(new_h - s_h), abs(new_w - s_w)
    # 上下左右平均padding
    up = dh//2
    down = dh - dh//2
    left = dw//2
    right = dw - dw//2
    dst = np.pad(src, ((up,down),(left,right)), "constant")
    return dst

# --------------- 上采样 ---------------
#转置卷积
def invConv_zc(src, new_h, new_w):
    import numpy as np

    def transposed_conv_numpy(src: np.ndarray, kernel: np.ndarray, stride=2, padding=0, output_padding=0):
        h, w = src.shape
        kernel_size = kernel.shape[0]

        # ========================
        # 1. 先把图像扩大（插入0）→ 上采样核心
        # ========================
        h_up = h * stride
        w_up = w * stride
        src_up = np.zeros((h_up, w_up), dtype=np.float32)
        src_up[::stride, ::stride] = src  # 每隔 stride 个位置放原值，其余补0

        # ========================
        # 2. 卷积核旋转180度（转置卷积规则）
        # ========================
        kernel_rot = np.rot90(kernel, 2)

        # ========================
        # 3. 计算输出尺寸
        # ========================
        h_out = h_up - kernel_size + 1 + 2 * padding + output_padding
        w_out = w_up - kernel_size + 1 + 2 * padding + output_padding

        # ========================
        # 4. 填充 padding
        # ========================
        if padding > 0:
            src_pad = np.pad(src_up, ((padding, padding), (padding, padding)), mode='constant')
        else:
            src_pad = src_up

        # ========================
        # 5. 普通卷积（和你之前学的一模一样）
        # ========================
        dst = np.zeros((h_out, w_out), dtype=np.float32)
        k = kernel_size
        for i in range(h_out):
            for j in range(w_out):
                window = src_pad[i:i + k, j:j + k]
                dst[i, j] = np.sum(window * kernel_rot)

        return dst

